# Block-device map used by the ZIP generator. Boot-time fstab comes from stock firmware.
# <device>                                <mount point>   <type>  <mount flags>  <fs_mgr flags>
/dev/block/bootdevice/by-name/boot         /boot           emmc    defaults       recoveryonly
/dev/block/bootdevice/by-name/dtbo         /dtbo           emmc    defaults       recoveryonly
/dev/block/bootdevice/by-name/init_boot    /init_boot      emmc    defaults       recoveryonly
/dev/block/bootdevice/by-name/vendor_boot  /vendor_boot    emmc    defaults       recoveryonly
/dev/block/bootdevice/by-name/recovery     /recovery       emmc    defaults       recoveryonly
/dev/block/bootdevice/by-name/cache        /cache          ext4    defaults       recoveryonly
system                                   /system         erofs   ro             logical
system_ext                               /system_ext     erofs   ro             logical
product                                  /product        erofs   ro             logical
vendor                                   /vendor         erofs   ro             logical
odm                                      /odm            erofs   ro             logical
vendor_dlkm                              /vendor_dlkm    erofs   ro             logical
system_dlkm                              /system_dlkm    erofs   ro             logical
